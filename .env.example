# Banco de dados Postgres
DATABASE_URL="postgresql://usuario:senha@localhost:5432/aws_comercial?schema=public"

# NextAuth
AUTH_SECRET="gere-uma-string-aleatoria-longa-aqui"
NEXTAUTH_URL="http://localhost:3000"

# Opcional: popula marca/indústria/cliente/produto de exemplo ao rodar o seed
# SEED_DEMO_DATA="true"

# Leitor universal de imagens (gere a chave em https://aistudio.google.com/apikey)
GEMINI_API_KEY="gere-sua-chave-no-google-ai-studio"
GEMINI_MODEL="gemini-flash-latest"
